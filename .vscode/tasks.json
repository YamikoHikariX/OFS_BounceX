{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "build",
            "type": "shell",
            "command": "cmake",
            "args": [
                "--build",
                "build/",
                "--config",
                "Release",
                "--target",
                "OpenFunscripter",
                "--parallel",
                "${env:NUMBER_OF_PROCESSORS}"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            }
        },
        {
            "label": "buildDebug",
            "type": "shell",
            "command": "cmake",
            "args": [
                "--build",
                "build/",
                "--config",
                "RelWithDebInfo",
                "--target",
                "OpenFunscripter",
                "--parallel",
                "${env:NUMBER_OF_PROCESSORS}"
            ],
            "group": "build"
        },
        {
            "label": "buildLocalization",
            "type": "shell",
            "command": "cmake",
            "args": [
                "--build",
                "build/",
                "--config",
                "Release",
                "--target",
                "gen_localization"
            ]
        }
    ]
}